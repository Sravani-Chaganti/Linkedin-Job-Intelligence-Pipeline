          "id": "IvpJX9726F8V1ggX",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get Gemini output (company info)\nconst geminiOutput = $input.first().json;\nconst geminiText = geminiOutput.text || geminiOutput.response || JSON.stringify(geminiOutput);\n\nlet companyInfo;\ntry {\n  // Try to parse JSON from Gemini response\n  const jsonMatch = geminiText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    companyInfo = JSON.parse(jsonMatch[0]);\n  } else {\n    companyInfo = {};\n  }\n} catch (err) {\n  companyInfo = {};\n}\n\n// Get ALL Apify job data from the previous node\nconst apifyData = $('Run an Actor and get dataset').all();\n\n// Process each Apify item and merge with company info\nconst results = apifyData.map((item, index) => {\n  const job = item.json;\n  \n  return {\n    json: {\n      \"Sector\": job.sector || job.industry || \"\",\n      \"Company Name\": companyInfo.companyName || job.companyName || job.company || \"\",\n      \"Email Address\": companyInfo.companyEmail || \"\",\n      \"Company LinkedIn\": companyInfo.companyUrl || job.companyUrl || job.companyLinkedinUrl || \"\",\n      \"Company Website\": companyInfo.companyWebsite || job.companyWebsite || \"\",\n      \"Experience\": job.juniorlevel || job.entrylevel || \"\",\n      \"Job Title\": job.title || job.jobTitle || \"\",\n      \"Job Apply URL\": job.link || job.applyUrl || job.url || \"\",\n      \"Job Description\": job.description || job.jobDescription || \"\",\n      \"Published Date\": job.listedAt || job.postedDate || job.publishedAt || \"\"\n    }\n  };\n});\n\nreturn results;"
      },
